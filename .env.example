DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
MISTRAL_API_KEY=
BUFFER_API_KEY=
BLOB_READ_WRITE_TOKEN=
# Public video hosting for Buffer (Buffer downloads the video from a public URL at publish time).
# Default: catbox  -> catbox.moe, free, anonymous, no account/token needed, 200 MB per video.
# Options: catbox | litterbox (temporary, 1h-72h, 1 GB) | vercel-blob (needs BLOB_READ_WRITE_TOKEN)
UPLOAD_PROVIDER=
# Only used with UPLOAD_PROVIDER=litterbox: 1h | 12h | 24h | 72h (default 72h)
LITTERBOX_EXPIRY=
